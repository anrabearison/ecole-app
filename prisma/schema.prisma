// ============================================================
// School management app — Prisma schema
// Naming convention: English for all models/fields (see docs/conventions.md)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum Role {
  PLATFORM_SUPER_ADMIN // no school (schoolId null) — manages all schools
  SCHOOL_ADMIN // full access, scoped to one school
  STAFF_ADMIN // administrative tasks only, scoped to one school
  TEACHER // own classrooms/subjects/grades/schedule only
  STUDENT // read-only, own data only
}

enum Cycle {
  PRIMARY
  MIDDLE_SCHOOL
  HIGH_SCHOOL
}

enum GradeType {
  EXAM
  DAILY
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

enum DeliberationDecision {
  PROMOTED
  REPEATED
}

enum StudentStatus {
  PASSING
  REPEATING
  TRIPLING
}

enum Sex {
  MALE
  FEMALE
}

enum TeacherContractType {
  FONCTIONNAIRE
  ENF
}

// ============================================================
// Multi-tenant root
// ============================================================

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  users               User[]
  schoolGrades        SchoolGrade[]
  tracks              Track[]
  classrooms          Classroom[]
  subjects            Subject[]
  students            Student[]
  teachers            Teacher[]
  teacherSubjects     TeacherSubject[]
  enrollments         Enrollment[]
  grades              Grade[]
  scheduleSlots       ScheduleSlot[]
  rooms               Room[]
  periods             Period[]
  reportCardComments  ReportCardComment[]
  deliberations       Deliberation[]
  subjectCoefficients SubjectCoefficient[]
  classroomHomeroomTeachers ClassroomHomeroomTeacher[]
}

// ============================================================
// Users & auth
// ============================================================

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // null only for PLATFORM_SUPER_ADMIN
  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id])

  // one-to-one with the role-specific profile, when applicable
  teacher Teacher?
  student Student?
}

// ============================================================
// School structure: Cycle -> SchoolGrade -> [Track] -> Classroom
// ============================================================

// "Niveau" — pedagogical level, e.g. "6ème", "Seconde", "Première"
// Named SchoolGrade to avoid clashing with the academic Grade (note) model.
model SchoolGrade {
  id    String @id @default(cuid())
  name  String // "6ème", "Seconde", "Première"
  cycle Cycle
  order Int // used for sorting levels logically

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  tracks              Track[] // empty unless this level has tracks (from Première onward)
  classrooms          Classroom[] // direct classrooms when the level has no track
  subjectCoefficients SubjectCoefficient[]

  @@unique([name, cycle, schoolId])
}

// "Série" — only relevant from Première onward (Littéraire/Scientifique: A, C, D, OSE)
model Track {
  id   String @id @default(cuid())
  name String // "A", "C", "D", "OSE"

  schoolGradeId String
  schoolGrade   SchoolGrade @relation(fields: [schoolGradeId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  classrooms          Classroom[]
  subjectCoefficients SubjectCoefficient[]

  @@unique([name, schoolGradeId])
}

// Physical classroom with students, e.g. "6ème A", "Première C1"
model Classroom {
  id       String @id @default(cuid())
  section  String // parallel class label: "A", "B", "1", "2"...
  schoolYear String // "2025-2026" — a classroom is scoped to one school year
  passingThreshold Float @default(10) // moyenne de délibération / seuil de passage

  schoolGradeId String
  schoolGrade   SchoolGrade @relation(fields: [schoolGradeId], references: [id])

  trackId String? // null if the level has no track (before Première)
  track   Track?  @relation(fields: [trackId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  students        Student[]
  enrollments     Enrollment[]
  teacherSubjects TeacherSubject[]
  grades          Grade[]
  scheduleSlots   ScheduleSlot[]
  homeroomTeachers ClassroomHomeroomTeacher[]

  @@unique([schoolGradeId, trackId, section, schoolYear])
}

// Junction table for classroom homeroom teachers (professeurs principaux)
// Allows multiple homeroom teachers per classroom
model ClassroomHomeroomTeacher {
  id        String @id @default(cuid())
  isPrimary Boolean @default(false) // marks the primary homeroom teacher

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@unique([classroomId, teacherId])
  @@index([classroomId])
  @@index([teacherId])
}

// ============================================================
// People: Student, Teacher
// ============================================================

model Student {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  firstName String?
  lastName  String
  dateOfBirth DateTime?
  guardianName String?
  guardianPhone String?
  registrationNumber String
  status StudentStatus @default(PASSING)
  placeOfBirth String?
  sex Sex?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  // current classroom — convenience shortcut for the active school year,
  // kept in sync with the latest Enrollment. Full history lives in Enrollment.
  classroomId String?
  classroom   Classroom? @relation(fields: [classroomId], references: [id])

  enrollments   Enrollment[]
  grades        Grade[]
  reportCardComments ReportCardComment[]
  deliberations Deliberation[]
  createdAt     DateTime @default(now())

  @@unique([registrationNumber, schoolId])
}

// Historizes a student's classroom assignment per school year.
// One row per (student, schoolYear) — enables showing past classrooms
// even after the student has moved to a new classroom.
model Enrollment {
  id         String @id @default(cuid())
  schoolYear String // "2025-2026"

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, schoolYear])
}

model Teacher {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique

  firstName String?
  lastName  String
  phone String?
  contractType TeacherContractType?
  registrationNumber String?
  nationalIdNumber String
  sex Sex?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  subjects           TeacherSubject[]
  grades             Grade[] // grades this teacher has personally entered
  scheduleSlots      ScheduleSlot[]
  homeroomClassrooms ClassroomHomeroomTeacher[]
  createdAt          DateTime @default(now())

  @@unique([nationalIdNumber, schoolId])
}

// ============================================================
// Subjects & teacher assignments
// ============================================================

model Subject {
  id         String  @id @default(cuid())
  name       String  // "Mathématiques", "Français"
  coefficient Float @default(1.0) // coefficient for general average calculation

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  teacherSubjects     TeacherSubject[]
  grades              Grade[]
  scheduleSlots       ScheduleSlot[]
  subjectCoefficients SubjectCoefficient[]

  @@unique([name, schoolId])
}

// Which teacher teaches which subject, in which classroom
// A teacher may teach a subject in some classrooms but not others.
model TeacherSubject {
  id String @id @default(cuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  @@unique([teacherId, subjectId, classroomId])
}

// ============================================================
// Grades (notes)
// ============================================================

model Grade {
  id        String    @id @default(cuid())
  value     Float
  type      GradeType
  date      DateTime
  comment   String?
  periodId  String    // required period for grade grouping

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  // the teacher who personally entered this grade — visibility is scoped to this field
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  // denormalized on purpose: enables querying "all grades for classroom X in subject Y"
  // without joining through Student every time
  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  period   Period @relation(fields: [periodId], references: [id])

  createdAt DateTime @default(now())
}

// ============================================================
// Periods (périodes scolaires)
// ============================================================

model Period {
  id         String   @id @default(cuid())
  name       String   // "Trimestre 1", "Bimestre 2", etc.
  order      Int      // for sorting periods chronologically
  schoolYear String   // "2025-2026"
  examWeight Float    @default(0.6) // weight for EXAM grades in average calculation
  dailyWeight Float   @default(0.4) // weight for DAILY grades in average calculation

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  grades   Grade[]
  reportCardComments ReportCardComment[]

  @@unique([name, schoolYear, schoolId])
}

// ============================================================
// Report Card Comments (appréciations bulletin)
// ============================================================

model ReportCardComment {
  id        String   @id @default(cuid())
  comment   String

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  periodId String
  period   Period @relation(fields: [periodId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())

  @@unique([studentId, periodId])
}
model Deliberation {
  id             String               @id @default(cuid())
  schoolYear     String
  studentAverage Float
  decision       DeliberationDecision
  observations   String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, schoolYear])
}
// ============================================================
// Schedule (emploi du temps)
// ============================================================

model Room {
  id   String @id @default(cuid())
  name String // "Salle 1", "Labo Sciences", "Gymnase"

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  scheduleSlots ScheduleSlot[]

  @@unique([name, schoolId])
}

model ScheduleSlot {
  id        String  @id @default(cuid())
  day       Weekday
  startTime String // "08:00"
  endTime   String // "10:00"
  roomId    String?
  room      Room?   @relation(fields: [roomId], references: [id])

  classroomId String
  classroom   Classroom @relation(fields: [classroomId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])
}

// ============================================================
// Subject Coefficients (coefficients par niveau et/ou série)
// ============================================================

// Stores the coefficient of a subject for a specific school grade (and optional track).
// Resolution order (fallback chain):
//   1. (subject, schoolGrade, track)  — specific to a série (Première A, Terminale C…)
//   2. (subject, schoolGrade, null)   — common to all classes of that level with no track
//   3. Subject.coefficient            — global default
model SubjectCoefficient {
  id          String @id @default(cuid())
  coefficient Float  @default(1.0)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  schoolGradeId String
  schoolGrade   SchoolGrade @relation(fields: [schoolGradeId], references: [id], onDelete: Cascade)

  // null  → applies to all classes of this level that have no track (6ème → Seconde)
  // non-null → applies only to this specific track (Première A, Terminale C…)
  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performance index — uniqueness enforced at application level to handle nullable trackId
  @@index([subjectId, schoolGradeId, trackId, schoolId])
  @@index([schoolGradeId, schoolId])
}
